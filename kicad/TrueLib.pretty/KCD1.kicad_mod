(footprint "KCD1"
  (version 20240108)
  (generator "pcbnew")
  (layer "F.Cu")
  (descr "KCD1 two-terminal rocker switch. Model-derived footprint for kcd1.stp.step: 7 mm pitch, 0.5 x 6 mm blades; plated slots 1.2 x 6.5 mm. Housing 20.5 x 14.5 mm. Verify against physical part before PCB manufacture.")
  (tags "KCD1 SPST rocker switch 2 pin 7mm")
  (attr through_hole)
  (property "Reference" "SW**" (at 0 -8.7 0) (layer "F.SilkS")
    (effects (font (size 1 1) (thickness 0.15))))
  (property "Value" "KCD1" (at 0 8.7 0) (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15))))
  (fp_rect (start -10.4 -7.4) (end 10.4 7.4)
    (stroke (width 0.12) (type solid)) (fill none) (layer "F.SilkS"))
  (fp_rect (start -10.25 -7.25) (end 10.25 7.25)
    (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
  (fp_rect (start -7.4 -5.75) (end 7.4 5.75)
    (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
  (fp_rect (start -10.75 -7.75) (end 10.75 7.75)
    (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
  (fp_text user "1" (at -1.6 0 0) (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15))))
  (fp_text user "2" (at 8.6 0 0) (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15))))
  (pad "1" thru_hole rect (at 0 0) (size 2.2 7.5)
    (drill oval 1.2 6.5) (layers "*.Cu" "*.Mask") (remove_unused_layers no))
  (pad "2" thru_hole oval (at 7 0) (size 2.2 7.5)
    (drill oval 1.2 6.5) (layers "*.Cu" "*.Mask") (remove_unused_layers no))
  (model "${TRUE_LIB}/kicad/TrueLib.3dshapes/kcd1.stp.step"
    (offset (xyz 0 0 1))
    (scale (xyz 1 1 1))
    (rotate (xyz 0 0 0)))
)
